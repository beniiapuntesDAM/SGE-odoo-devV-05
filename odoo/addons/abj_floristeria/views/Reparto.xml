<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_reparto_tree" model="ir.ui.view">
        <field name="name">abj_floristeria.reparto.tree</field>
        <field name="model">abj_floristeria.reparto</field>
        <field name="arch" type="xml">
            <tree string="Repartos">
                <field name="codigo"/>
                <field name="matricula"/>
                <field name="fecha_reparto"/>
                <field name="pedido_ids"/>
            </tree>
        </field>
    </record>

    <record id="view_reparto_form" model="ir.ui.view">
        <field name="name">abj_floristeria.reparto.form</field>
        <field name="model">abj_floristeria.reparto</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="codigo"/>
                        <field name="matricula"/>
                        <field name="fecha_reparto"/>
                    </group>

                    <notebook>
                        <page string="Pedidos asignados">
                            <field name="pedido_ids">
                                <tree editable="bottom">
                                    <field name="cliente_id"/>
                                    <field name="ramo_id"/>
                                    <field name="fecha"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
