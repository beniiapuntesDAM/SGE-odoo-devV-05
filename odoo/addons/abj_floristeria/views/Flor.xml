<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_flor_form" model="ir.ui.view">
    <field name="name">abj_floristeria.flor.form</field>
    <field name="model">abj_floristeria.flor</field>
    <field name="arch" type="xml">
        <form string="Flor">
            <sheet>
                <group>
                    <field name="tipo"/>
                    <field name="color"/>
                    <field name="precio"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

<record id="view_flor_tree" model="ir.ui.view">
    <field name="name">abj_floristeria.flor.tree</field>
    <field name="model">abj_floristeria.flor</field>
    <field name="arch" type="xml">
        <tree string="Flores">
            <field name="tipo"/>
            <field name="color"/>
            <field name="precio"/>
        </tree>
    </field>
</record>

<record id="view_flor_kanban" model="ir.ui.view">
    <field name="name">abj_floristeria.flor.kanban</field>
    <field name="model">abj_floristeria.flor</field>
    <field name="arch" type="xml">
        <kanban class="o_kanban_small_column" default_group_by="tipo">

            <!-- CAMPOS NECESARIOS PARA EL TEMPLATE -->
            <field name="tipo"/>
            <field name="color"/>
            <field name="precio"/>
            <field name="imagen_tipo"/>

            <templates>
                <t t-name="kanban-box">
                    <div class="oe_kanban_global_click" style="position:relative;">

                        <div class="o_kanban_record_body">
                            <strong><field name="tipo"/></strong>
                            <div>Color: <field name="color"/></div>
                            <div>Precio: <field name="precio"/> €</div>
                        </div>

                        <!-- IMAGEN PEQUEÑA ABAJO A LA DERECHA -->
                        <div style="position:absolute; bottom:4px; right:4px; width:32px; height:32px;">
                            <img t-att-src="record.imagen_tipo.value"
                                 style="width:100%; height:100%; object-fit:contain;"/>
                        </div>

                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>




</odoo>
