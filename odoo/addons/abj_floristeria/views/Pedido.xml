<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pedido_tree" model="ir.ui.view">
        <field name="name">abj_floristeria.pedido.tree</field>
        <field name="model">abj_floristeria.pedido</field>
        <field name="arch" type="xml">
            <tree string="Pedidos">
                <field name="cliente_id"/>
                <field name="ramo_id"/>
                <field name="fecha"/>
            </tree>
        </field>
    </record>

    <record id="view_pedido_form" model="ir.ui.view">
    <field name="name">abj_floristeria.pedido.form</field>
    <field name="model">abj_floristeria.pedido</field>
    <field name="arch" type="xml">
        <form string="Pedido">
            <sheet>
                <group>
                    <field name="cliente_id"/>
                    <field name="ramo_id"/>
                    <field name="fecha"/>
                </group>

                <notebook>
                    <page string="Reparto asignado">
                        <field name="reparto_id">
                            <tree>
                                <field name="codigo"/>
                                <field name="matricula"/>
                            </tree>
                        </field>
                    </page>
                </notebook>

            </sheet>
        </form>
    </field>
</record>

</odoo>
