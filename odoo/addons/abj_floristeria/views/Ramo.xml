<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ramo_tree" model="ir.ui.view">
        <field name="name">abj_floristeria.ramo.tree</field>
        <field name="model">abj_floristeria.ramo</field>
        <field name="arch" type="xml">
            <tree string="Ramos">
                <field name="nombre"/>
                <field name="flores_nombres"/>
                <field name="precio_total"/>
            </tree>
        </field>
    </record>

    <record id="view_ramo_form" model="ir.ui.view">
        <field name="name">abj_floristeria.ramo.form</field>
        <field name="model">abj_floristeria.ramo</field>
        <field name="arch" type="xml">
            <form string="Ramo">
                <sheet>
                    <group>
                        <field name="nombre"/>
                        <field name="precio_total" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Flores del ramo">
                            <field name="flor_ids">
                                <tree>
                                    <field name="nombre"/>
                                    <field name="tipo"/>
                                    <field name="color"/>
                                    <field name="precio"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

<record id="view_ramo_kanban" model="ir.ui.view">
    <field name="name">abj_floristeria.ramo.kanban</field>
    <field name="model">abj_floristeria.ramo</field>
    <field name="arch" type="xml">
        <kanban>
            <field name="nombre"/>
            <field name="precio_total"/>
            <field name="flores_nombres"/>
            <templates>
                <t t-name="kanban-box">
                    <div class="oe_kanban_global_click o_kanban_record"
                        style="background:white; padding:12px; border-radius:8px;
                                box-shadow:0 2px 6px rgba(0,0,0,0.15);">

                        <strong style="font-size:16px; color:#333; display:block; margin-bottom:8px;">
                            <field name="nombre"/>
                        </strong>
                        <div style="background-color:#dde7ff; padding:6px; margin-top:6px; border-radius:4px; font-size:13px;"> Flores:
                            <t t-esc="record.flores_nombres.value"/>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>

</odoo>
