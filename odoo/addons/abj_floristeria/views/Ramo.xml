<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- TREE -->
    <record id="view_ramo_tree" model="ir.ui.view">
        <field name="name">abj_floristeria.ramo.tree</field>
        <field name="model">abj_floristeria.ramo</field>
        <field name="arch" type="xml">
            <tree string="Ramos">
                <field name="nombre"/>
                <field name="flor_ids"/>
            </tree>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_ramo_form" model="ir.ui.view">
        <field name="name">abj_floristeria.ramo.form</field>
        <field name="model">abj_floristeria.ramo</field>
        <field name="arch" type="xml">
            <form string="Ramo">
                <sheet>
                    <group>
                        <field name="nombre"/>
                    </group>

                    <notebook>
                        <page string="Flores del ramo">
                            <field name="flor_ids">
                                <tree editable="bottom">
                                    <field name="tipo"/>
                                    <field name="color"/>
                                    <field name="precio"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- KANBAN -->
    <record id="view_ramo_kanban" model="ir.ui.view">
        <field name="name">abj_floristeria.ramo.kanban</field>
        <field name="model">abj_floristeria.ramo</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <strong><field name="nombre"/></strong>
                            <div>Flores: <t t-esc="record.flor_ids.count"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
